  "item": [
    {
      "name": "1. Регистрация пользователя 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('User created successfully', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('id');",
              "    pm.expect(response).to.have.property('username');",
              "    pm.expect(response).to.have.property('email');",
              "    pm.expect(response).to.have.property('firstName');",
              "    pm.expect(response).to.have.property('lastName');",
              "    pm.expect(response).to.have.property('phone');",
              "    pm.expect(response).to.have.property('is_active');",
              "    pm.expect(response.is_active).to.equal(true);",
              "});",
              "",
              "pm.test('User data matches request', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.username).to.equal(pm.variables.get('user1_username'));",
              "    pm.expect(response.email).to.equal(pm.variables.get('user1_email'));",
              "    pm.expect(response.firstName).to.equal(pm.variables.get('user1_first_name'));",
              "    pm.expect(response.lastName).to.equal(pm.variables.get('user1_last_name'));",
              "    pm.expect(response.phone).to.equal(pm.variables.get('user1_phone'));",
              "});",
              "",
              "pm.test('Response time is less than 500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Pre-request Script для коллекции\r",
              "function generateRandomString(length = 8) {\r",
              "    const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\r",
              "    let result = '';\r",
              "    for (let i = 0; i < length; i++) {\r",
              "        result += chars.charAt(Math.floor(Math.random() * chars.length));\r",
              "    }\r",
              "    return result;\r",
              "}\r",
              "\r",
              "function generateUserData() {\r",
              "    const username = `user_${generateRandomString(6)}`;\r",
              "    const password = `Pass${generateRandomString(8)}!@#`;\r",
              "    const firstName = `First${generateRandomString(4)}`;\r",
              "    const lastName = `Last${generateRandomString(4)}`;\r",
              "    const email = `${username}@example.com`;\r",
              "    const phone = `+7${Math.floor(1000000000 + Math.random() * 9000000000)}`;\r",
              "    \r",
              "    return { username, password, firstName, lastName, email, phone };\r",
              "}\r",
              "\r",
              "const user1Data = generateUserData();\r",
              "pm.variables.set('user1_username', user1Data.username);\r",
              "pm.variables.set('user1_password', user1Data.password);\r",
              "pm.variables.set('user1_first_name', user1Data.firstName);\r",
              "pm.variables.set('user1_last_name', user1Data.lastName);\r",
              "pm.variables.set('user1_email', user1Data.email);\r",
              "pm.variables.set('user1_phone', user1Data.phone);\r",
              "\r",
              "pm.variables.set('user1_updated_first_name', `Updated${Math.random().toString(36).substring(2, 6)}`);\r",
              "pm.variables.set('user1_updated_last_name', `Updated${Math.random().toString(36).substring(2, 6)}`);\r",
              "pm.variables.set('user1_updated_email', `updated_${user1Data.username}@example.com`);\r",
              "pm.variables.set('user1_updated_phone', `+7${Math.floor(1000000000 + Math.random() * 9000000000)}`);\r",
              "\r",
              "const user2Data = generateUserData();\r",
              "pm.variables.set('user2_username', user2Data.username);\r",
              "pm.variables.set('user2_password', user2Data.password);\r",
              "pm.variables.set('user2_first_name', user2Data.firstName);\r",
              "pm.variables.set('user2_last_name', user2Data.lastName);\r",
              "pm.variables.set('user2_email', user2Data.email);\r",
              "pm.variables.set('user2_phone', user2Data.phone);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{user1_username}}\",\n    \"password\": \"{{user1_password}}\",\n    \"email\": \"{{user1_email}}\",\n    \"first_name\": \"{{user1_first_name}}\",\n    \"last_name\": \"{{user1_last_name}}\",\n    \"phone\": \"{{user1_phone}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
